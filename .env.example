# Canonical origin. Production uses the verified custom domain; keep localhost for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for local builds. The verified public Sites deployment uses true.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Keep disabled locally unless testing consent and events against a dedicated property.
NEXT_PUBLIC_ANALYTICS_PROVIDER=disabled
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Private GA4 dashboard. The client secret and session secret must be stored as hosting secrets.
GOOGLE_ANALYTICS_PROPERTY_ID=549251072
ANALYTICS_ALLOWED_EMAIL=alegfink@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ANALYTICS_SESSION_SECRET=

# Direct email is public. Enable only after deploying and testing the private Apps Script receiver.
CONTACT_PROVIDER=disabled
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_RECIPIENT_EMAIL=alegfink@gmail.com
