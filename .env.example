# Canonical origin. Required before publication.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for local/preview builds. Enable only for the verified production domain.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Analytics is intentionally inert until a provider adapter is implemented and reviewed.
NEXT_PUBLIC_ANALYTICS_PROVIDER=disabled

# Contact remains disabled unless all three values are real and tested.
CONTACT_PROVIDER=disabled
CONTACT_WEBHOOK_URL=
CONTACT_RECIPIENT_EMAIL=
