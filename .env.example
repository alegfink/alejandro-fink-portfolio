# Canonical origin. Use the public Sites URL until a custom domain is adopted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false for local builds. The verified public Sites deployment uses true.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Analytics is intentionally inert until a provider adapter is implemented and reviewed.
NEXT_PUBLIC_ANALYTICS_PROVIDER=disabled

# Direct email is public. Enable only after deploying and testing the private Apps Script receiver.
CONTACT_PROVIDER=disabled
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_RECIPIENT_EMAIL=alegfink@gmail.com
